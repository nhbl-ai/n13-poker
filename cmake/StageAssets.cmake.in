set(ASSETS "@GAME_ASSETS@")
file(MAKE_DIRECTORY "${DESTINATION}")
foreach(ASSET IN LISTS ASSETS)
    file(COPY "${ASSET}" DESTINATION "${DESTINATION}")
endforeach()
file(COPY "@CMAKE_BINARY_DIR@/resources.manifest" DESTINATION "${DESTINATION}")
foreach(NAME users.txt player.txt Leaderboard.txt)
    # Rebuilding must not erase accounts, balances, or the leaderboard.
    if(NOT EXISTS "${DESTINATION}/${NAME}")
        file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/data/defaults/${NAME}" DESTINATION "${DESTINATION}")
    endif()
endforeach()
if(NOT "@OPENAL_DLL@" STREQUAL "")
    file(COPY "@OPENAL_DLL@" DESTINATION "${DESTINATION}")
endif()
